[
  {
    "type": "function",
    "function": {
      "name": "get_context",
      "description": "读取当前草稿概况、BPM、小节换算、原始选择和轨迹列表。音频与本机路径不提供。",
      "strict": true,
      "parameters": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "list_regions",
      "description": "分页列出当前草稿的区域段落及矩形；任何分段修改后，索引可能改变，应重新查询。",
      "strict": true,
      "parameters": {
        "type": "object",
        "properties": {
          "offset": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5000
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 32
          }
        },
        "required": [
          "offset",
          "limit"
        ],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "get_region",
      "description": "读取某段中某个矩形及其完整运动关键帧；索引均从 0 开始。",
      "strict": true,
      "parameters": {
        "type": "object",
        "properties": {
          "region_index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4999
          },
          "rect_index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 31
          }
        },
        "required": [
          "region_index",
          "rect_index"
        ],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "get_notes",
      "description": "分页读取头部位于 [start_beat,end_beat) 的音符。返回 ID、拍数、轨迹、持续拍。",
      "strict": true,
      "parameters": {
        "type": "object",
        "properties": {
          "start_beat": {
            "type": "number",
            "minimum": 0,
            "maximum": 600000
          },
          "end_beat": {
            "type": "number",
            "minimum": 0,
            "maximum": 600000
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "maximum": 20000
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          }
        },
        "required": [
          "start_beat",
          "end_beat",
          "offset",
          "limit"
        ],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "get_track",
      "description": "读取指定轨迹的全部关键帧，修改前用它保留未要求更改的帧。",
      "strict": true,
      "parameters": {
        "type": "object",
        "properties": {
          "line_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$",
            "maxLength": 64
          }
        },
        "required": [
          "line_id"
        ],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "animate_region",
      "description": "在所选段落内部的 [start_beat,end_beat) 修改一个矩形的平移/旋转。保留其他矩形与范围外内容。起止矩形可用不同尺寸实现缩放。跨已有段落时改用 set_region 明确替换范围。",
      "strict": true,
      "parameters": {
        "type": "object",
        "properties": {
          "region_index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4999
          },
          "rect_index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 31
          },
          "start_beat": {
            "type": "number",
            "minimum": 0,
            "maximum": 600000
          },
          "end_beat": {
            "type": "number",
            "minimum": 0,
            "maximum": 600000
          },
          "start_rect": {
            "type": "array",
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "minItems": 4,
            "maxItems": 4
          },
          "end_rect": {
            "type": "array",
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "minItems": 4,
            "maxItems": 4
          },
          "start_angle": {
            "type": "number",
            "minimum": -36000,
            "maximum": 36000
          },
          "end_angle": {
            "type": "number",
            "minimum": -36000,
            "maximum": 36000
          },
          "ease": {
            "type": "string",
            "enum": [
              "linear",
              "smooth",
              "hold"
            ]
          }
        },
        "required": [
          "region_index",
          "rect_index",
          "start_beat",
          "end_beat",
          "start_rect",
          "end_rect",
          "start_angle",
          "end_angle",
          "ease"
        ],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "set_region",
      "description": "显式替换 [start_beat,end_beat) 内的整组矩形和运动；范围外内容保留。motions=[] 表示全静态，否则与 rects 对应。谨慎使用，区间内旧内容会被替换。",
      "strict": true,
      "parameters": {
        "type": "object",
        "properties": {
          "start_beat": {
            "type": "number",
            "minimum": 0,
            "maximum": 600000
          },
          "end_beat": {
            "type": "number",
            "minimum": 0,
            "maximum": 600000
          },
          "label": {
            "type": "string",
            "maxLength": 80
          },
          "rects": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "minItems": 4,
              "maxItems": 4
            },
            "minItems": 0,
            "maxItems": 32
          },
          "motions": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "beat": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 600000
                  },
                  "x": {
                    "type": "number",
                    "minimum": -200,
                    "maximum": 200
                  },
                  "y": {
                    "type": "number",
                    "minimum": -200,
                    "maximum": 200
                  },
                  "angle": {
                    "type": "number",
                    "minimum": -36000,
                    "maximum": 36000
                  },
                  "ease": {
                    "type": "string",
                    "enum": [
                      "linear",
                      "smooth",
                      "hold"
                    ]
                  }
                },
                "required": [
                  "beat",
                  "x",
                  "y",
                  "angle",
                  "ease"
                ],
                "additionalProperties": false
              },
              "minItems": 0,
              "maxItems": 256
            },
            "minItems": 0,
            "maxItems": 32
          }
        },
        "required": [
          "start_beat",
          "end_beat",
          "label",
          "rects",
          "motions"
        ],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "set_track",
      "description": "新增轨迹或替换指定轨迹的全部关键帧。现有音符绑定 ID 不变。只支持横向位置和线透明度。",
      "strict": true,
      "parameters": {
        "type": "object",
        "properties": {
          "line_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$",
            "maxLength": 64
          },
          "name": {
            "type": "string",
            "maxLength": 80
          },
          "frames": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "beat": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 600000
                },
                "x": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                "alpha": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "ease": {
                  "type": "string",
                  "enum": [
                    "linear",
                    "smooth",
                    "hold"
                  ]
                }
              },
              "required": [
                "beat",
                "x",
                "alpha",
                "ease"
              ],
              "additionalProperties": false
            },
            "minItems": 1,
            "maxItems": 256
          }
        },
        "required": [
          "line_id",
          "name",
          "frames"
        ],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "set_track_events",
      "description": "替换指定轨迹的一栏时间条，其他栏和绑定音符保留。先 get_track 保留该栏未修改的条目。x 为 0–100，alpha 为 0–1，speed 为 0–8；events=[] 固定初始值。",
      "strict": true,
      "parameters": {
        "type": "object",
        "properties": {
          "line_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$",
            "maxLength": 64
          },
          "channel": {
            "type": "string",
            "enum": [
              "x",
              "alpha",
              "speed"
            ]
          },
          "events": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "start": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 600000
                },
                "end": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 600000
                },
                "from": {
                  "type": "number",
                  "minimum": -36000,
                  "maximum": 36000
                },
                "to": {
                  "type": "number",
                  "minimum": -36000,
                  "maximum": 36000
                },
                "ease": {
                  "type": "string",
                  "enum": [
                    "linear",
                    "sine_in_out",
                    "sine_in",
                    "sine_out",
                    "smooth",
                    "hold"
                  ]
                }
              },
              "required": [
                "start",
                "end",
                "from",
                "to",
                "ease"
              ],
              "additionalProperties": false
            },
            "minItems": 0,
            "maxItems": 256
          }
        },
        "required": [
          "line_id",
          "channel",
          "events"
        ],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "delete_track",
      "description": "删除无音符绑定的线。至少保留一条线，且仅在用户要求删除时调用。",
      "strict": true,
      "parameters": {
        "type": "object",
        "properties": {
          "line_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$",
            "maxLength": 64
          }
        },
        "required": [
          "line_id"
        ],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "set_region_center",
      "description": "替换某矩形的中心点栏时间条；from/to 为绝对 [X,Y]。先 get_region 读取并保留未修改的时间条，其他栏不变。",
      "strict": true,
      "parameters": {
        "type": "object",
        "properties": {
          "region_index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4999
          },
          "rect_index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 31
          },
          "events": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "start": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 600000
                },
                "end": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 600000
                },
                "from": {
                  "type": "array",
                  "items": {
                    "type": "number",
                    "minimum": -200,
                    "maximum": 300
                  },
                  "minItems": 2,
                  "maxItems": 2
                },
                "to": {
                  "type": "array",
                  "items": {
                    "type": "number",
                    "minimum": -200,
                    "maximum": 300
                  },
                  "minItems": 2,
                  "maxItems": 2
                },
                "ease": {
                  "type": "string",
                  "enum": [
                    "linear",
                    "sine_in_out",
                    "sine_in",
                    "sine_out",
                    "smooth",
                    "hold"
                  ]
                }
              },
              "required": [
                "start",
                "end",
                "from",
                "to",
                "ease"
              ],
              "additionalProperties": false
            },
            "minItems": 0,
            "maxItems": 256
          }
        },
        "required": [
          "region_index",
          "rect_index",
          "events"
        ],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "set_region_events",
      "description": "替换某矩形的一栏时间条，其他栏不变。angle 是顺时针度数 ±36000；width/height 为总长/总宽 0.1–400（全屏为 100）。先 get_region 保留未修改条目。",
      "strict": true,
      "parameters": {
        "type": "object",
        "properties": {
          "region_index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4999
          },
          "rect_index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 31
          },
          "channel": {
            "type": "string",
            "enum": [
              "angle",
              "width",
              "height"
            ]
          },
          "events": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "start": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 600000
                },
                "end": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 600000
                },
                "from": {
                  "type": "number",
                  "minimum": -36000,
                  "maximum": 36000
                },
                "to": {
                  "type": "number",
                  "minimum": -36000,
                  "maximum": 36000
                },
                "ease": {
                  "type": "string",
                  "enum": [
                    "linear",
                    "sine_in_out",
                    "sine_in",
                    "sine_out",
                    "smooth",
                    "hold"
                  ]
                }
              },
              "required": [
                "start",
                "end",
                "from",
                "to",
                "ease"
              ],
              "additionalProperties": false
            },
            "minItems": 0,
            "maxItems": 256
          }
        },
        "required": [
          "region_index",
          "rect_index",
          "channel",
          "events"
        ],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "edit_notes",
      "description": "批量新建或修改音符：id=null 新建，否则修改已有 ID；length=0 为 Tap，>0 为 Hold。拍数精确保存，不自动吸附网格。",
      "strict": true,
      "parameters": {
        "type": "object",
        "properties": {
          "notes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 1000000000
                },
                "beat": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 600000
                },
                "line": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{1,64}$",
                  "maxLength": 64
                },
                "length": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 600000
                }
              },
              "required": [
                "id",
                "beat",
                "line",
                "length"
              ],
              "additionalProperties": false
            },
            "minItems": 1,
            "maxItems": 1000
          }
        },
        "required": [
          "notes"
        ],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "delete_notes",
      "description": "删除明确指定的已有音符 ID；只有用户要求删除时调用。",
      "strict": true,
      "parameters": {
        "type": "object",
        "properties": {
          "ids": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000000
            },
            "minItems": 1,
            "maxItems": 1000
          }
        },
        "required": [
          "ids"
        ],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "validate_chart",
      "description": "检查当前草稿可玩性，包括区域可触及性、重叠、音频关联。检查错误不授权修改未请求的音符。",
      "strict": true,
      "parameters": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      }
    }
  }
]
